{
  "expo": {
    "name": "Kalam",
    "slug": "kalam",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.kalam.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#EDE9FF",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.kalam.app"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "scheme": "kalam",
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "backgroundColor": "#EDE9FF",
          "dark": {
            "image": "./assets/splash-icon.png",
            "backgroundColor": "#12111F"
          }
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Kalam utilise le micro pour que vous pratiquiez la prononciation.",
          "speechRecognitionPermission": "Kalam utilise la reconnaissance vocale pour évaluer votre prononciation."
        }
      ]
    ],
    "description": "Apprends les langues en parlant."
  }
}